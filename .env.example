# Copy this file to .env.local and adjust for your own machine.
# Do not commit .env.local or real database credentials.

ASDC_DB_HOST=127.0.0.1
ASDC_DB_PORT=
ASDC_DB_NAME=aromin_sison_dental
ASDC_DB_USER=root
ASDC_DB_PASS=

# Examples:
# XAMPP commonly uses 3306 or 3307 depending on the installation.
# Laragon commonly uses 3306 unless changed.
# Shared development DB values will be provided by the database owner/provider.

# Gmail SMTP (for password reset and notification emails)
ASDC_GMAIL_ADDRESS=
ASDC_GMAIL_APP_PASSWORD=
ASDC_MAIL_FROM_NAME=Aromin-Sison Dental Clinic
