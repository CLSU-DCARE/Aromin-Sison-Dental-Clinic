# Database configuration (defaults work with XAMPP/Laragon)
ASDC_DB_HOST=127.0.0.1
ASDC_DB_PORT=3306
ASDC_DB_NAME=aromin_sison_dental
ASDC_DB_USER=root
ASDC_DB_PASS=

# Shared staff account provisioning (set locally before running
# php database/bootstrap_staff.php; never commit the actual passwords).
ASDC_BOOTSTRAP_RECEPTIONIST_PASSWORD=
ASDC_BOOTSTRAP_DENTIST_PASSWORD=

# Gmail SMTP (for password reset emails)
ASDC_GMAIL_ADDRESS=
ASDC_GMAIL_APP_PASSWORD=
ASDC_MAIL_FROM_NAME=Aromin-Sison Dental Clinic

# The public address of the site. Password reset emails use it for their link.
# Live server example:  https://clinic.example.com
# Local example:        http://localhost/Aromin-Sison-Dental-Clinic
ASDC_APP_URL=

# Only needed if PHP sits behind a proxy you control (Nginx, a load balancer) on
# the SAME server. Comma-separated list of that proxy's own IP address(es).
# Leave empty on a normal single-server setup like this project's - X-Forwarded-For
# is sent by the visitor's own browser and can be faked, so it is only trusted when
# it comes from an address in this list.
ASDC_TRUSTED_PROXIES=

# Keep session audit entries this many days. The daily CLI maintenance task
# removes expired sessions/tokens and audit rows beyond this period.
ASDC_AUDIT_RETENTION_DAYS=90
