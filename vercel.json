{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "/", "dest": "/public-website/index.html" },
    { "src": "/about", "dest": "/public-website/about.html" },
    { "src": "/dentists", "dest": "/public-website/dentist.html" },
    { "src": "/services", "dest": "/public-website/services.html" },
    { "src": "/gallery", "dest": "/public-website/gallery.html" },
    { "src": "/login", "dest": "/auth/login.html" },
    { "src": "/admin-login", "dest": "/auth/admin-login.html" },
    { "src": "/forgot-password", "dest": "/auth/forgot-password.html" },
    { "src": "/reset-password", "dest": "/auth/reset-password.html" },
    { "src": "/patient-login", "dest": "/auth/patient-login.html" },
    { "src": "/patient-signup", "dest": "/auth/patient-signup.html" },
    { "src": "/dashboard", "dest": "/admin-system/dashboard.html" },
    { "src": "/patient-chart", "dest": "/admin-system/patient-chart.html" },
    { "src": "/patient-dashboard", "dest": "/patient-dashboard/dashboard.html" },
    { "src": "/dentist-dashboard", "dest": "/dentist-dashboard/dashboard.html" },
    {
      "src": "/backend/(.*)",
      "dest": "https://asdc-api-production.up.railway.app/backend/$1",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
        "Pragma": "no-cache",
        "Expires": "0"
      }
    }
  ],
  "headers": [
    {
      "source": "/backend/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
